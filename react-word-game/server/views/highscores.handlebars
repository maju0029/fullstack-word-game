<ul class="highscore-list">
    {{#each highscores}}
        <li class="highscore-item">
            <span class="player-name">{{this.name}}</span>
            <span class="score-time">{{this.timeMs}} ms</span>
            <span class="score-guesses">{{this.guesses.length}} guesses</span>
            <span class="score-length">{{this.wordLength}} letters</span>
            <span class="score-unique">
                {{#if this.uniqueLetters}}Unique letters{{else}}Repeated letters allowed{{/if}}
            </span>
        </li>
    {{/each}}
</ul>